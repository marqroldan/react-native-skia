{
  "branches": [
    "main",
    {
      "name": "next",
      "prerelease": "next"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "semantic-release-yarn",
      {
        "npmPublish": false,
        "tarballDir": "dist"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "node ./scripts/pack-pdf-package.js --version ${nextRelease.version} --output dist --publish --tag ${nextRelease.channel || 'latest'}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {"path": "dist/react-native-skia-pdf-*.tgz", "label": "PDF package tarball"}
        ]
      }
    ]
  ]
}
