diff --git a/modules/canvaskit/pdf.js b/modules/canvaskit/pdf.js
new file mode 100644
index 00000000..8fd10b41
--- /dev/null
+++ b/modules/canvaskit/pdf.js
@@ -0,0 +1,15 @@
+// Adds the PDF document factory to PDF-enabled CanvasKit builds.
+CanvasKit._extraInitializations = CanvasKit._extraInitializations || [];
+CanvasKit._extraInitializations.push(function() {
+  CanvasKit['PDF'] = {
+    'isAvailable': function() {
+      return typeof CanvasKit['_MakePDFDocument'] === 'function';
+    },
+    'MakeDocument': function(metadata) {
+      if (!CanvasKit['PDF']['isAvailable']()) {
+        return null;
+      }
+      return CanvasKit['_MakePDFDocument'](metadata || {});
+    },
+  };
+});

diff --git a/modules/canvaskit/pdf_bindings.cpp b/modules/canvaskit/pdf_bindings.cpp
new file mode 100644
index 00000000..a4377b41
--- /dev/null
+++ b/modules/canvaskit/pdf_bindings.cpp
@@ -0,0 +1,239 @@
+// Copyright 2026
+//
+// Web bindings for Skia's native PDF document writer. CanvasKit normally
+// disables SkPDF, so this file is compiled only by the PDF-enabled build.
+
+#include <ctime>
+#include <memory>
+#include <string>
+
+#include <emscripten/bind.h>
+
+#include "include/core/SkCanvas.h"
+#include "include/core/SkData.h"
+#include "include/core/SkDocument.h"
+#include "include/core/SkStream.h"
+#include "include/docs/SkPDFDocument.h"
+#include "include/docs/SkPDFJpegHelpers.h"
+#include "src/base/SkBase64.h"
+
+#include "WasmCommon.h"
+
+namespace {
+
+using emscripten::allow_raw_pointers;
+using emscripten::class_;
+using emscripten::function;
+using emscripten::val;
+
+using PDFBytes = val;
+
+PDFBytes copyData(const sk_sp<const SkData>& data) {
+    const size_t size = data ? data->size() : 0;
+    auto result = val::global("Uint8Array").new_(size);
+    if (size != 0) {
+        result.call<void>("set", val(emscripten::typed_memory_view(size, data->bytes())));
+    }
+    return result;
+}
+
+void readString(const val& values, const char* name, SkString* field) {
+    const val value = values[name];
+    if (value.isString()) {
+        const auto text = value.as<std::string>();
+        field->set(text.c_str());
+    }
+}
+
+SkPDF::DateTime dateTimeFromEpochMilliseconds(double epochMs) {
+    SkPDF::DateTime dateTime = {0, 0, 0, 0, 0, 0, 0, 0};
+    const auto seconds = static_cast<time_t>(epochMs / 1000.0);
+    struct tm utc = {};
+    if (gmtime_r(&seconds, &utc) == nullptr) {
+        return dateTime;
+    }
+    dateTime.fTimeZoneMinutes = 0;
+    dateTime.fYear = static_cast<uint16_t>(utc.tm_year + 1900);
+    dateTime.fMonth = static_cast<uint8_t>(utc.tm_mon + 1);
+    dateTime.fDayOfWeek = static_cast<uint8_t>(utc.tm_wday);
+    dateTime.fDay = static_cast<uint8_t>(utc.tm_mday);
+    dateTime.fHour = static_cast<uint8_t>(utc.tm_hour);
+    dateTime.fMinute = static_cast<uint8_t>(utc.tm_min);
+    dateTime.fSecond = static_cast<uint8_t>(utc.tm_sec);
+    return dateTime;
+}
+
+void readDate(const val& values, const char* name, SkPDF::DateTime* field) {
+    const val value = values[name];
+    if (value.isUndefined() || value.isNull() || value["getTime"].isUndefined()) {
+        return;
+    }
+    *field = dateTimeFromEpochMilliseconds(value.call<double>("getTime"));
+}
+
+SkPDF::Metadata metadataFromValue(const val& values) {
+    auto metadata = SkPDF::JPEG::MetadataWithCallbacks();
+    // Print-first default. Unsupported PDF features are rasterized at this
+    // DPI instead of Skia's screen-oriented 72 DPI default.
+    metadata.fRasterDPI = 300;
+
+    if (values.isNull() || values.isUndefined()) {
+        return metadata;
+    }
+    readString(values, "title", &metadata.fTitle);
+    readString(values, "author", &metadata.fAuthor);
+    readString(values, "subject", &metadata.fSubject);
+    readString(values, "keywords", &metadata.fKeywords);
+    readString(values, "creator", &metadata.fCreator);
+    readString(values, "producer", &metadata.fProducer);
+    readString(values, "lang", &metadata.fLang);
+
+    const val rasterDPI = values["rasterDPI"];
+    if (rasterDPI.isNumber()) {
+        metadata.fRasterDPI = rasterDPI.as<float>();
+    }
+    const val encodingQuality = values["encodingQuality"];
+    if (encodingQuality.isNumber()) {
+        metadata.fEncodingQuality = encodingQuality.as<int>();
+    }
+    readDate(values, "creationDate", &metadata.fCreation);
+    readDate(values, "modifiedDate", &metadata.fModified);
+    return metadata;
+}
+
+class WebPDFDocument {
+public:
+    enum class State { OpenNoPage, OpenWithPage, Closed, Aborted };
+
+    static std::shared_ptr<WebPDFDocument> Make(const SkPDF::Metadata& metadata) {
+        auto document = std::shared_ptr<WebPDFDocument>(new WebPDFDocument());
+        document->document_ = SkPDF::MakeDocument(&document->stream_, metadata);
+        if (document->document_ == nullptr) {
+            return nullptr;
+        }
+        return document;
+    }
+
+    ~WebPDFDocument() {
+        if (document_ && (state_ == State::OpenNoPage || state_ == State::OpenWithPage)) {
+            document_->abort();
+        }
+    }
+
+    SkCanvas* beginPage(float width, float height, const val& contentRect) {
+        if (state_ != State::OpenNoPage || !(width > 0 && height > 0) || !document_) {
+            return nullptr;
+        }
+
+        SkRect rect;
+        const SkRect* rectPtr = nullptr;
+        if (!contentRect.isUndefined() && !contentRect.isNull()) {
+            rect = SkRect::MakeLTRB(contentRect[0].as<float>(),
+                                    contentRect[1].as<float>(),
+                                    contentRect[2].as<float>(),
+                                    contentRect[3].as<float>());
+            rectPtr = &rect;
+        }
+
+        auto* canvas = document_->beginPage(width, height, rectPtr);
+        if (canvas != nullptr) {
+            state_ = State::OpenWithPage;
+        }
+        return canvas;
+    }
+
+    bool endPage() {
+        if (state_ != State::OpenWithPage || !document_) {
+            return false;
+        }
+        document_->endPage();
+        state_ = State::OpenNoPage;
+        return true;
+    }
+
+    PDFBytes close() {
+        if (state_ == State::Closed) {
+            return copyData(result_);
+        }
+        if (state_ != State::OpenNoPage || !document_) {
+            return val::undefined();
+        }
+        document_->close();
+        result_ = stream_.detachAsData();
+        document_ = nullptr;
+        state_ = State::Closed;
+        return copyData(result_);
+    }
+
+    PDFBytes makeData() const {
+        return state_ == State::Closed ? copyData(result_) : val::undefined();
+    }
+
+    std::string getBase64() const {
+        if (state_ != State::Closed || !result_) {
+            return {};
+        }
+        const size_t length = SkBase64::EncodedSize(result_->size());
+        std::string encoded(length, '\0');
+        const size_t written = SkBase64::Encode(result_->bytes(), result_->size(), encoded.data());
+        encoded.resize(written);
+        return encoded;
+    }
+
+    bool abort() {
+        if (state_ == State::Aborted) {
+            return true;
+        }
+        if (state_ == State::Closed || !document_) {
+            return false;
+        }
+        document_->abort();
+        document_ = nullptr;
+        stream_.reset();
+        state_ = State::Aborted;
+        return true;
+    }
+
+    std::string state() const {
+        switch (state_) {
+            case State::OpenNoPage:
+                return "open";
+            case State::OpenWithPage:
+                return "page-open";
+            case State::Closed:
+                return "closed";
+            case State::Aborted:
+                return "aborted";
+        }
+        return "aborted";
+    }
+
+private:
+    WebPDFDocument() = default;
+
+    // The stream must outlive SkDocument because SkDocument retains the stream
+    // for the duration of its lifetime.
+    SkDynamicMemoryWStream stream_;
+    sk_sp<SkDocument> document_;
+    State state_ = State::OpenNoPage;
+    sk_sp<SkData> result_;
+};
+
+std::shared_ptr<WebPDFDocument> makePDFDocument(const val& values) {
+    return WebPDFDocument::Make(metadataFromValue(values));
+}
+
+} // namespace
+
+EMSCRIPTEN_BINDINGS(SkiaPDF) {
+    class_<WebPDFDocument>("PDFDocument")
+        .smart_ptr<std::shared_ptr<WebPDFDocument>>("shared_ptr<PDFDocument>")
+        .function("_beginPage", &WebPDFDocument::beginPage, allow_raw_pointers())
+        .function("_endPage", &WebPDFDocument::endPage)
+        .function("_close", &WebPDFDocument::close)
+        .function("_makeData", &WebPDFDocument::makeData)
+        .function("_getBase64", &WebPDFDocument::getBase64)
+        .function("_abort", &WebPDFDocument::abort)
+        .property("state", &WebPDFDocument::state);
+    function("_MakePDFDocument", &makePDFDocument);
+}

